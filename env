# =============================================================================
# Zeta CMS Environment Configuration
# =============================================================================
# Chỉnh sửa các giá trị bên dưới theo môi trường của bạn

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection
DATABASE_URL=postgresql://user:120301@localhost:5432/builder_orbit_lab
POSTGRES_DB=builder_orbit_lab
POSTGRES_USER=user
POSTGRES_PASSWORD=120301

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Environment: development, staging, production
NODE_ENV=development
# Backend port
PORT=4000
# Frontend port
FRONTEND_PORT=8080

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# JWT secret key (CHANGE IN PRODUCTION!)
JWT_SECRET=b04b675bdf633bd54a071fa5a1510d5f116b361b085d81cfdb45bca4242e99cb
# Token expiration time
JWT_EXPIRES_IN=7d

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Upload directory
UPLOAD_DIR=./uploads
# Max file size in bytes (10MB)
MAX_FILE_SIZE=10485760
# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================
# Redis cache connection
REDIS_URL=redis://localhost:6379

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Zeta CMS <noreply@yourdomain.com>

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CORS allowed origins
# For local: http://localhost:8080
# For VPS: http://your-vps-ip:8080
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:8080
# Rate limiting window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window
RATE_LIMIT_MAX_REQUESTS=1000

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Number of days to keep backups
BACKUP_RETENTION_DAYS=7
# Cron schedule for backups (daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# SSL CONFIGURATION
# =============================================================================
# SSL certificate paths
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=debug
# Enable metrics collection
ENABLE_METRICS=true

# =============================================================================
# FRONTEND CONFIGURATION (Vite)
# =============================================================================
# Backend API URL
# For local: http://localhost:4000/api
# For VPS: http://your-vps-ip:4000/api
# For production: https://yourdomain.com/api
VITE_API_URL=http://localhost:4000/api
# Application name
VITE_APP_NAME=Zeta CMS
# Application version
VITE_APP_VERSION=1.0.0

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable debug mode
DEBUG=true
# Enable hot reload
HOT_RELOAD=true
# Use mock API
MOCK_API=false

# =============================================================================
# PRODUCTION OVERRIDES (Uncomment for production)
# =============================================================================
# NODE_ENV=production
# LOG_LEVEL=info
# DEBUG=false
# HOT_RELOAD=false
# CORS_ORIGIN=https://yourdomain.com
# VITE_API_URL=https://yourdomain.com/api
# JWT_SECRET=your_super_secure_jwt_secret_here
# POSTGRES_PASSWORD=your_super_secure_database_password_here

# =============================================================================
# VPS OVERRIDES (Uncomment for VPS without domain)
# =============================================================================
# CORS_ORIGIN=http://your-vps-ip:8080
# VITE_API_URL=http://your-vps-ip:4000/api

# =============================================================================
# ADVANCED CONFIGURATION (Optional)
# =============================================================================
# Session secret
# SESSION_SECRET=your_session_secret_here
# Encryption key
# ENCRYPTION_KEY=your_encryption_key_here
# API rate limit
# API_RATE_LIMIT=1000

# =============================================================================
# NOTIFICATION CONFIGURATION (Optional)
# =============================================================================
# Slack webhook URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# Discord webhook URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
# Telegram bot token
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Telegram chat ID
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# =============================================================================
# ANALYTICS CONFIGURATION (Optional)
# =============================================================================
# Google Analytics ID
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# Mixpanel token
# MIXPANEL_TOKEN=your_mixpanel_token
# Sentry DSN
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable user registration
# ENABLE_USER_REGISTRATION=true
# Enable email verification
# ENABLE_EMAIL_VERIFICATION=false
# Enable two-factor authentication
# ENABLE_TWO_FACTOR_AUTH=false
# Enable social login
# ENABLE_SOCIAL_LOGIN=false
# Enable API documentation
# ENABLE_API_DOCS=true
# Enable metrics
# ENABLE_METRICS=true
# Enable debug mode
# ENABLE_DEBUG_MODE=false
